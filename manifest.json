{
  "manifest_version": 3,
  "name": "Amazon Alexa for Shopping Suppressor",
  "version": "0.3.0",
  "description": "Removes Alexa for Shopping/Rufus from Amazon and repairs the blank sidebar gutter. Includes a local on/off toggle and no tracking.",
  "homepage_url": "https://github.com/JohnnyZLi/amazon-alexa-shopping-suppressor",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Alexa Shopping Suppressor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://amazon.com/*",
        "https://www.amazon.com/*",
        "https://amazon.ca/*",
        "https://www.amazon.ca/*",
        "https://amazon.com.mx/*",
        "https://www.amazon.com.mx/*",
        "https://amazon.com.br/*",
        "https://www.amazon.com.br/*",
        "https://amazon.co.uk/*",
        "https://www.amazon.co.uk/*",
        "https://amazon.de/*",
        "https://www.amazon.de/*",
        "https://amazon.fr/*",
        "https://www.amazon.fr/*",
        "https://amazon.it/*",
        "https://www.amazon.it/*",
        "https://amazon.es/*",
        "https://www.amazon.es/*",
        "https://amazon.nl/*",
        "https://www.amazon.nl/*",
        "https://amazon.com.be/*",
        "https://www.amazon.com.be/*",
        "https://amazon.se/*",
        "https://www.amazon.se/*",
        "https://amazon.pl/*",
        "https://www.amazon.pl/*",
        "https://amazon.ie/*",
        "https://www.amazon.ie/*",
        "https://amazon.com.tr/*",
        "https://www.amazon.com.tr/*",
        "https://amazon.ae/*",
        "https://www.amazon.ae/*",
        "https://amazon.sa/*",
        "https://www.amazon.sa/*",
        "https://amazon.eg/*",
        "https://www.amazon.eg/*",
        "https://amazon.co.za/*",
        "https://www.amazon.co.za/*",
        "https://amazon.co.jp/*",
        "https://www.amazon.co.jp/*",
        "https://amazon.in/*",
        "https://www.amazon.in/*",
        "https://amazon.sg/*",
        "https://www.amazon.sg/*",
        "https://amazon.com.au/*",
        "https://www.amazon.com.au/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
